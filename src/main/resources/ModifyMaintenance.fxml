<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="Controllers.ModifyMaintenanceController">
    <TextField fx:id="descriptionField" promptText="Enter description" />
    <TextField fx:id="dateField" promptText="Enter maintenance date" />
    <ComboBox fx:id="etatComboBox" />
    <Button fx:id="saveButton" text="Save" onAction="#onSaveButtonClick" />
</VBox>
