<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ActivityController" style="-fx-background-color: #F4F4F4;">
    <children>
        <VBox layoutX="50.0" layoutY="30.0" spacing="10.0" prefWidth="350.0" prefHeight="500.0" style="-fx-padding: 15; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <HBox spacing="8">
                    <Label text="Activity Name:*" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="nameId" prefWidth="200.0" />
                </HBox>
                <HBox spacing="8">
                    <Label text="Description:*" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextArea fx:id="descriptionId" prefWidth="280.0" prefHeight="70.0" />
                </HBox>
                <HBox spacing="8">
                    <Label text="Date:*" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <DatePicker fx:id="dateId" prefWidth="180.0" />
                </HBox>
                <HBox spacing="8">
                    <Label text="Hour:*" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="hourId" prefWidth="120.0" />
                </HBox>
                <HBox spacing="8">
                    <Label text="Duration (min):*" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="durationId" prefWidth="120.0" />
                </HBox>
                <HBox spacing="8">
                    <Label text="Max members:*" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="maxID" prefWidth="120.0" />
                </HBox>
                <HBox spacing="8">
                    <Label text="Coach Name:*" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <ComboBox fx:id="listID" prefWidth="220.0" />
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="tableID" layoutX="450.0" layoutY="30.0" onMouseClicked="#loadDataToForm" prefHeight="500.0" prefWidth="580.0" style="-fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <columns>
                <TableColumn fx:id="nameColumnID" text="Activity Name" prefWidth="200.0" />
                <TableColumn fx:id="dateColumnId" text="Date" prefWidth="180.0" />
                <TableColumn fx:id="maxColumnId" text="Max Members" prefWidth="160.0" />
            </columns>
        </TableView>

        <HBox layoutX="450.0" layoutY="550.0" spacing="12">
            <children>
                <Button text="Add" onAction="#add" style="-fx-background-color: #2F2F5A; -fx-text-fill: WHITE; -fx-font-size: 18px; -fx-padding: 12; -fx-background-radius: 5;" />
                <Button text="Update" onAction="#update" style="-fx-background-color: #2F2F5A; -fx-text-fill: WHITE; -fx-font-size: 18px; -fx-padding: 12; -fx-background-radius: 5;" />
                <Button text="Delete" onAction="#delete" style="-fx-background-color: #2F2F5A; -fx-text-fill: WHITE; -fx-font-size: 18px; -fx-padding: 12; -fx-background-radius: 5;" />
            </children>
        </HBox>
    </children>
</AnchorPane>
