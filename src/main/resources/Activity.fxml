<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<AnchorPane prefHeight="600.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ActivityController" style="-fx-background-color: #F4F4F4;">
    <children>
        <!-- Panneau latéral -->
        <VBox layoutX="0.0" layoutY="0.0" prefWidth="250.0" prefHeight="600.0" style="-fx-background-color: #393969; -fx-padding: 20; -fx-spacing: 20;">
            <children>
                <ImageView fitHeight="80.0" fitWidth="80.0" />
                <Label text="Nom d’utilisateur" textFill="WHITE" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10;" />

                <Button text="Activities planning" prefWidth="200.0" style="-fx-background-color: #FFFFFF; -fx-text-fill: #2F2F5A; -fx-font-size: 16px; -fx-padding: 12; -fx-background-radius: 5;" />

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 40 0 0 10;">
                    <ImageView fitHeight="20.0" fitWidth="20.0" />
                    <Label text="Logout" textFill="WHITE" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 5;" />
                </HBox>
            </children>
        </VBox>


        <!-- Formulaire de saisie -->
        <VBox layoutX="270.0" layoutY="30.0" spacing="15.0" prefWidth="350.0" prefHeight="500.0" style="-fx-padding: 20; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <HBox spacing="10">
                    <Label text="Activity Name:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="nameId" prefWidth="200.0" style="-fx-background-radius: 5;" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Description:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextArea fx:id="descriptionId" prefWidth="280.0" prefHeight="80.0" style="-fx-background-radius: 5;" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Date:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <DatePicker fx:id="dateId" prefWidth="180.0" style="-fx-background-radius: 5;" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Hour:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="hourId" prefWidth="120.0" style="-fx-background-radius: 5;" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Duration (min):" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="durationId" prefWidth="120.0" style="-fx-background-radius: 5;" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Max members:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <TextField fx:id="maxID" prefWidth="120.0" style="-fx-background-radius: 5;" />
                </HBox>
                <HBox spacing="10">
                    <Label text="Coach Name:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                    <ComboBox fx:id="listID" prefWidth="220.0" style="-fx-background-radius: 5;" />
                </HBox>
            </children>
        </VBox>

        <!-- Tableau des activités -->
        <TableView fx:id="tableID" layoutX="650.0" layoutY="30.0" onMouseClicked="#loadDataToForm" prefHeight="500.0" prefWidth="400.0" style="-fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <columns>
                <TableColumn fx:id="nameColumnID" text="Activity Name" prefWidth="150.0" style="-fx-font-weight: bold;" />
                <TableColumn fx:id="dateColumnId" text="Date" prefWidth="130.0" style="-fx-font-weight: bold;" />
                <TableColumn fx:id="maxColumnId" text="Max Members" prefWidth="120.0" style="-fx-font-weight: bold;" />
            </columns>
        </TableView>

        <!-- Boutons d'action -->
        <HBox layoutX="650.0" layoutY="550.0" spacing="15">
            <children>
                <Button text="Add" onAction="#add" style="-fx-background-color: #2F2F5A; -fx-text-fill: WHITE; -fx-font-size: 16px; -fx-padding: 10; -fx-background-radius: 5;" />
                <Button text="Update" onAction="#update" style="-fx-background-color: #2F2F5A; -fx-text-fill: WHITE; -fx-font-size: 16px; -fx-padding: 10; -fx-background-radius: 5;" />
                <Button text="Delete" onAction="#delete" style="-fx-background-color: #B22222; -fx-text-fill: WHITE; -fx-font-size: 16px; -fx-padding: 10; -fx-background-radius: 5;" />
            </children>
        </HBox>
    </children>
</AnchorPane>