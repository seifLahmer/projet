<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ReservationController" style="-fx-background-color: #F4F4F4;">
    <children>
        <VBox layoutX="50.0" layoutY="30.0" spacing="15.0" prefWidth="700.0" prefHeight="540.0" style="-fx-padding: 20; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <Label text="Activities List" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                <!-- Filters -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Activity" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                    <ComboBox fx:id="activityFilter" promptText="Choose an Activity" style="-fx-pref-width: 180px;"/>
                    <Label text="Date" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                    <DatePicker fx:id="dateFilter" style="-fx-pref-width: 150px;"/>
                    <Button text="Filter" onAction="#filtrerActivites" style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8;"/>
                    <Button text="Reset" onAction="#resetFilters" style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8;"/>
                </HBox>

                <!-- Activities List with ScrollPane -->
                <ScrollPane fx:id="scrollPaneActivites" fitToWidth="true" style="-fx-background: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 5;" prefHeight="360">
                    <VBox fx:id="activitesDispoContainer" spacing="10" style="-fx-padding: 10px;">
                        <!-- Sample activity card -->
                        <HBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
                            <ImageView fitHeight="80.0" fitWidth="80.0"/>
                            <VBox spacing="3">
                                <Label text="Activity: Yoga" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Label text="Date: 2023-10-15" style="-fx-font-size: 12px;"/>
                                <Label text="Time: 10:00 AM" style="-fx-font-size: 12px;"/>
                                <Label text="Coach: John Doe" style="-fx-font-size: 12px;"/>
                                <Label text="Available Spots: 10" style="-fx-font-size: 12px;"/>
                            </VBox>
                            <Button text="Reserve" style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 16; -fx-background-radius: 5;"/>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- View Reservations Button -->
                <Button text="View My Reservations" onAction="#afficherMesReservations" style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8px 16px; -fx-background-radius: 5;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
