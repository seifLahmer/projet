<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.geometry.Insets?>

<AnchorPane prefHeight="600.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ReservationController" style="-fx-background-color: #F4F4F4;">
    <children>
        <!-- Panneau latéral -->
        <VBox layoutX="0.0" layoutY="0.0" prefWidth="250.0" prefHeight="600.0" style="-fx-background-color: #393969 ; -fx-padding: 20; -fx-spacing: 20;">
            <children>
                <ImageView fitHeight="80.0" fitWidth="80.0" />
                <Label text="Nom d’utilisateur" textFill="WHITE" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10;" />

                <Button text="Activities planning" prefWidth="200.0" style="-fx-background-color: #393969 ; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 12; -fx-background-radius: 5; -fx-border-color: white " />

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 40 0 0 10;">
                    <ImageView fitHeight="20.0" fitWidth="20.0" />
                    <Label text="Logout" textFill="WHITE" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 5;" />
                </HBox>
            </children>
        </VBox>

        <!-- Contenu principal -->
        <VBox layoutX="270.0" layoutY="30.0" spacing="20.0" prefWidth="800.0" prefHeight="500.0" style="-fx-padding: 20; -fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <Label text="Activités Disponibles" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

                <!-- Filtres -->
                <HBox spacing="10" alignment="CENTER">
                    <ComboBox fx:id="activityFilter" promptText="Choisir une activité" style="-fx-pref-width: 200px; -fx-background-radius: 5;"/>
                    <DatePicker fx:id="dateFilter" style="-fx-pref-width: 150px; -fx-background-radius: 5;"/>
                    <Button text="Filtrer" onAction="#filtrerActivites" style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5;"/>
                    <Button text="Reset Filters" onAction="#resetFilters" style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5;"/>
                </HBox>

                <!-- Liste des activités avec ScrollPane -->
                <ScrollPane fx:id="scrollPaneActivites" fitToWidth="true"
                            style="-fx-background: transparent; -fx-border-color: #CCCCCC; -fx-border-radius: 5;"
                            prefHeight="400" prefWidth="760">
                    <VBox fx:id="activitesDispoContainer" spacing="15" alignment="CENTER"
                          style="-fx-pref-width: 740px; -fx-padding: 10px; -fx-background-color: #FFFFFF;">
                        <!-- Exemple de carte d'activité -->
                        <HBox style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
                            <ImageView fitHeight="100.0" fitWidth="100.0" style="-fx-margin: 0 15 0 0;"/>
                            <VBox spacing="5" style="-fx-padding: 0 15 0 0;">
                                <Label text="Activity Name: Yoga" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                                <Label text="Date: 2023-10-15" style="-fx-font-size: 14px;"/>
                                <Label text="Hour: 10:00 AM" style="-fx-font-size: 14px;"/>
                                <Label text="Coach: John Doe" style="-fx-font-size: 14px;"/>
                                <Label text="Available Places: 10" style="-fx-font-size: 14px;"/>
                            </VBox>
                            <Button text="Reservation" style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 15 25; -fx-background-radius: 5; -fx-alignment: CENTER;"/>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- Bouton pour voir les réservations -->
                <Button text="Voir mes réservations" onAction="#afficherMesReservations"
                        style="-fx-background-color: #393969; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 20px; -fx-background-radius: 5;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>