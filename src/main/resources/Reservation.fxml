<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.ReservationController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20px; -fx-pref-width: 700px;">

    <Label text="Activités Disponibles" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Filtres -->
    <HBox spacing="10" alignment="CENTER">
        <ComboBox fx:id="activityFilter" promptText="Choisir une activité"/>
        <DatePicker fx:id="dateFilter"/>
        <Button text="Filtrer" onAction="#filtrerActivites"/>
    </HBox>

    <!-- Liste des activités avec ScrollPane -->
    <ScrollPane fx:id="scrollPaneActivites" fitToWidth="true"
                style="-fx-background: transparent; -fx-border-color: gray;"
                prefHeight="400" prefWidth="680">
        <VBox fx:id="activitesDispoContainer" spacing="10" alignment="CENTER"
              style="-fx-pref-width: 660px; -fx-padding: 10px;"/>
    </ScrollPane>

    <Button text="Voir mes réservations" onAction="#afficherMesReservations"
            style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px;"/>
</VBox>
