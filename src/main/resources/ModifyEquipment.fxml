<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="585.0" prefWidth="473.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="Controllers.ModifyEquipmentController">
    <children>
        <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="50" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="50">

            <Label prefHeight="35.0" prefWidth="254.0" style="-fx-font-size: 24; -fx-font-weight: bold;" text="Modifier l'équipement" />

            <!-- Equipment ID -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Equipment ID: " />
                <TextField fx:id="idField" editable="false" />
            </HBox>

            <!-- Equipment Name -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Equipment Name: " />
                <TextField fx:id="nameField" />
            </HBox>

            <!-- Category -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Category: " />
                <TextField fx:id="categoryField" />
            </HBox>

            <!-- Quantity -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Quantity: " />
                <TextField fx:id="quantityField" />
            </HBox>

            <!-- Achat Date -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Achat Date: " />
                <TextField fx:id="achatDateField" />
            </HBox>

            <!-- Last Maintenance Date -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Last Maintenance Date: " />
                <TextField fx:id="lastMaintenanceDateField" />
            </HBox>

            <!-- Etat -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Etat: " />
                <TextField fx:id="etatField" />
            </HBox>

            <Button fx:id="saveButton" onAction="#onSaveButtonClick" text="Save" />
        </VBox>
    </children>
</AnchorPane>
