         <Image url="@logo.png" />
      </image>
   </ImageView>
   <Text layoutX="225.0" layoutY="145.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Bienvenu sur le portail Admin." />
   <Text layoutX="37.0" layoutY="463.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Etat" />
   <Text layoutX="34.0" layoutY="409.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Date de la derniere maintenance" />
   <Text layoutX="34.0" layoutY="324.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Quantité" />
   <Text layoutX="34.0" layoutY="366.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Date d'achat" />
   <Text layoutX="34.0" layoutY="281.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Catégorie" />
   <Text layoutX="34.0" layoutY="236.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nom" />
   <Text layoutX="34.0" layoutY="194.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID" />
</AnchorPane>
