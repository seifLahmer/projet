<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.UpdateMemberController">
    <children>
        <Label layoutX="50.0" layoutY="30.0" text="First Name:" />
        <TextField fx:id="txtFirstName" layoutX="150.0" layoutY="25.0" prefWidth="200.0" />

        <Label layoutX="50.0" layoutY="70.0" text="Last Name:" />
        <TextField fx:id="txtLastName" layoutX="150.0" layoutY="65.0" prefWidth="200.0" />

        <Label layoutX="50.0" layoutY="110.0" text="Email:" />
        <TextField fx:id="txtEmail" layoutX="150.0" layoutY="105.0" prefWidth="200.0" />

        <Label layoutX="50.0" layoutY="150.0" text="Phone Number:" />
        <TextField fx:id="txtPhoneNumber" layoutX="150.0" layoutY="145.0" prefWidth="200.0" />

        <Button fx:id="btnSave" layoutX="150.0" layoutY="200.0" text="Save" onAction="#handleSave" />
        <Button fx:id="btnCancel" layoutX="250.0" layoutY="200.0" text="Cancel" onAction="#handleCancel"/>
    </children>
</AnchorPane>
