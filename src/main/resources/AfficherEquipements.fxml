<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1100.0" style="-fx-background-color: #F9F9F9;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AfficherEquipementsController">
    <children>
        <!-- Table View to display equipments -->
        <TableView fx:id="equipmentTable" layoutX="10.0" layoutY="10.0" prefHeight="600.0" prefWidth="1060.0" style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colID" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="150.0" text="Name" />
                <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                <TableColumn fx:id="colQuantity" prefWidth="100.0" text="Quantity" />
                <TableColumn fx:id="colPurchaseDate" prefWidth="130.0" text="Purchase Date" />
                <TableColumn fx:id="colMaintenanceDate" prefWidth="130.0" text="Maintenance Date" />
                <TableColumn fx:id="colState" prefWidth="120.0" text="State" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
