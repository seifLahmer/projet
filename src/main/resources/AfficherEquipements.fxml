<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="616.0" prefWidth="854.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.AfficherEquipementsController"
            stylesheets="@style.css">

    <!-- TableView for Equipments -->
    <TableView fx:id="equipementsTable" layoutX="1.0" layoutY="20.0" prefHeight="350.0" prefWidth="830.0">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Nom" />
            <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Categorie" />
            <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="Quantité" />
            <TableColumn fx:id="achatDateColumn" prefWidth="130.0" text="Achat Date" />
            <TableColumn fx:id="maintenanceDateColumn" prefWidth="130.0" text="Maintenance Date" />
            <TableColumn fx:id="etatColumn" prefWidth="100.0" text="Etat" />
            <TableColumn fx:id="actionColumn" prefWidth="170.0" text="Actions" />
        </columns>
    </TableView>

    <!-- Buttons Section -->
    <HBox spacing="20.0" layoutX="260.0" layoutY="380.0" alignment="CENTER">
        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshEquipements" text="Refresh" />
        <Button text="Download Equipment PDF" onAction="#onDownloadEquipementPdf" />
    </HBox>

</AnchorPane>
