<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AdherentProductController"
            prefHeight="600.0" prefWidth="800.0">

    <VBox spacing="10" alignment="CENTER" prefWidth="800">
        <Label text="Choix des Produits" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- Tableau des produits -->
        <TableView fx:id="productTable" prefHeight="300" prefWidth="750">
            <columns>
                <TableColumn text="ID" fx:id="idColumn" prefWidth="50"/>
                <TableColumn text="Nom" fx:id="nameColumn" prefWidth="150"/>
                <TableColumn text="Description" fx:id="descriptionColumn" prefWidth="200"/>
                <TableColumn text="Prix" fx:id="priceColumn" prefWidth="100"/>
                <TableColumn text="Type" fx:id="typeColumn" prefWidth="150"/>
                <TableColumn text="Quantité" fx:id="quantityColumn" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Bouton pour ajouter au panier -->
        <Button text="Ajouter au panier" onAction="#addToCart"/>

        <!-- Panier -->
        <Label text="Panier" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <TableView fx:id="cartTable" prefHeight="150" prefWidth="750">
            <columns>
                <TableColumn text="Nom" fx:id="cartNameColumn" prefWidth="150"/>
                <TableColumn text="Prix" fx:id="cartPriceColumn" prefWidth="100"/>
                <TableColumn text="Quantité" fx:id="cartQuantityColumn" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Total et paiement -->
        <HBox spacing="10">
            <Label text="Total à payer :"/>
            <Label fx:id="totalLabel" text="0.0"/>
            <Button text="Payer" onAction="#pay"/>
        </HBox>
    </VBox>
</AnchorPane>