<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.ProductController"
            prefHeight="600.0" prefWidth="800.0">

    <VBox spacing="10" alignment="CENTER" prefWidth="800">
        <Label text="Gestion des Produits" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- Zone de saisie -->
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Nom :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Description :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="descriptionField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Prix :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="priceField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Type de produit :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="typeField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Quantité disponible :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="quantityField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>

        <!-- Boutons d'action -->
        <HBox spacing="10">
            <Button text="Ajouter" onAction="#addProduct"/>
            <Button text="Modifier" onAction="#updateProduct"/>
            <Button text="Supprimer" onAction="#deleteProduct"/>
        </HBox>

        <!-- Tableau des produits -->
        <TableView fx:id="tableID" onMouseClicked="#loadDataToForm" prefHeight="300" prefWidth="750">
            <columns>
                <TableColumn text="ID" fx:id="idColumn" prefWidth="50"/>
                <TableColumn text="Nom" fx:id="nameColumn" prefWidth="150"/>
                <TableColumn text="Description" fx:id="descriptionColumn" prefWidth="200"/>
                <TableColumn text="Prix" fx:id="priceColumn" prefWidth="100"/>
                <TableColumn text="Type" fx:id="typeColumn" prefWidth="150"/>
                <TableColumn text="Quantité" fx:id="quantityColumn" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>

