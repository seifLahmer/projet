<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.PasswordRecoveryController" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-border-color: #d3d3d3; -fx-border-radius: 10; -fx-background-radius: 10;">
    <children>
        <Label text="Récupération du mot de passe" textFill="#2a2a2a">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <TextField fx:id="emailField" promptText="Entrez votre email Gmail" prefWidth="250.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ccc;"/>

        <Button text="Récupérer" prefWidth="250.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;" onAction="#handleSendEmail">
            <font>
                <Font size="16.0" />
            </font>
        </Button>
    </children>
</VBox>