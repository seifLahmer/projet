<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.ActivitesReserveesController"
      spacing="20" alignment="TOP_CENTER"
      style="-fx-padding: 20px; -fx-background-color: #F0F4F8;">

    <!-- Header Label with larger, bold text -->
    <Label text="Your Planning "
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <!-- ScrollPane with a preferred height and transparent background -->
    <ScrollPane fitToWidth="true" prefHeight="500" style="-fx-background-color: transparent;">
        <content>
            <!-- FlowPane container for reservation items with padding, rounded corners, and border -->
            <FlowPane fx:id="activitesReserveesContainer" hgap="15" vgap="15" alignment="CENTER"
                      style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #CCCCCC;"/>
        </content>
    </ScrollPane>
</VBox>
