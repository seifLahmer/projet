<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="564.0" prefWidth="825.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="Controllers.AfficherMaintenance" stylesheets="@style.css">
    <children>
        <!-- Title Label -->
        <Label layoutX="315.0" layoutY="23.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Liste des Maintenances" />

        <!-- TableView for displaying maintenance records -->
        <TableView fx:id="maintenanceTable" layoutX="14.0" layoutY="60.0" prefHeight="428.0" prefWidth="806.0">
            <columns>
                <TableColumn fx:id="maintenanceIdColumn" text="ID" />
                <TableColumn fx:id="equipementIdColumn" prefWidth="100" text="Equipement ID" />
                <TableColumn fx:id="maintenanceDateColumn" prefWidth="100" text="Date Maintenance" />
                <TableColumn fx:id="descriptionColumn" prefWidth="150" text="Description" />
                <TableColumn fx:id="coutColumn" prefWidth="100" text="Coût" />
                <TableColumn fx:id="effectueParColumn" prefWidth="100" text="Effectué Par" />
                <!-- Add the missing action column -->
                <TableColumn fx:id="actionColumn" prefWidth="200" text="Actions" />
            </columns>
        </TableView>

        <!-- Button to refresh the table -->
        <Button layoutX="379.0" layoutY="512.0" onAction="#refreshMaintenances" text="Actualiser" />
        <Button text="Download Maintenance PDF" onAction="#onDownloadMaintenancePdf" />
    </children>
</AnchorPane>
